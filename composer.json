{
    "name": "routegroup/laravel-imoje",
    "description": "Package for imoje payments",
    "version": "0.5.0",
    "keywords": [
        "routegroup",
        "laravel",
        "imoje"
    ],
    "homepage": "https://github.com/routegroup/laravel-imoje",
    "license": "MIT",
    "authors": [
        {
            "name": "Kajetan Nobel",
            "email": "k.nobel@routegroup.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/contracts": "^8.0",
        "justinrainbow/json-schema": "^5.2",
        "myclabs/php-enum": "^1.8"
    },
    "require-dev": {
        "nunomaduro/collision": "^5.0|^6.0|^7.0",
        "phpstan/phpstan": "^1.0",
        "orchestra/testbench": "^6.0|^7.0|^8.0",
        "pestphp/pest": "^1.0|^2.0",
        "pestphp/pest-plugin-laravel": "^1.0|^2.0",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Routegroup\\Imoje\\Payment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Routegroup\\Imoje\\Payment\\Tests\\": "tests/"
        }
    },
     "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse src --memory-limit=1G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Routegroup\\Imoje\\Payment\\ImojeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
